# Copying this file is OPTIONAL. docker compose already has workshop defaults.
# Make a .env only if you want to override them.

AWS_REGION=us-east-1
TABLE_NAME=survey-responses

# Local DynamoDB container. Set this to an empty value to use real AWS instead.
DYNAMODB_ENDPOINT=http://dynamodb:8000

# DynamoDB Local ignores these, but boto3 refuses to start without something.
# Remove both lines when pointing at real AWS, so your ~/.aws profile is used.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
